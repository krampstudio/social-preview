{
    "manifest_version": 3,
    "name": "Social Preview",
    "version": "2.0.0",
    "description": "Preview how the current page looks when shared on X, Facebook, LinkedIn, Slack and Discord.",
    "icons": {
        "16": "icon16.png",
        "32": "icon32.png",
        "48": "icon48.png",
        "96": "icon96.png",
        "128": "icon128.png"
    },
    "permissions": [
        "activeTab",
        "scripting"
    ],
    "action": {
        "default_title": "Social Preview",
        "default_popup": "popup.html",
        "default_icon": {
            "16": "icon16.png",
            "32": "icon32.png",
            "48": "icon48.png",
            "96": "icon96.png",
            "128": "icon128.png"
        }
    },
    "browser_specific_settings": {
        "gecko": {
            "id": "social-preview@krampstudio.com",
            "strict_min_version": "140.0",
            "data_collection_permissions": {
                "required": [
                    "none"
                ]
            }
        },
        "gecko_android": {
            "strict_min_version": "142.0"
        }
    }
}
